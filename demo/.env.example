# 강사 시연용 LangSmith 설정 — demo/.env 로 복사해서 키를 넣는다 (demo/.env 는 커밋하지 않는다)
#   노트북: 준비 칸이 이 파일을 읽어 trace 를 남긴다
#   Studio: lab/langgraph.json 이 이 파일을 읽어, Studio 에서 돌린 실행도 같은 project 에 남긴다
# 실습(lab/.env)에는 넣지 않는다. 학생 실습 실행은 LangSmith 에 남지 않는다
# 키를 넣고 true 로 바꾼다 (키 없이 true 면 Studio 에 401 경고가 계속 찍힌다)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# project 이름에 공백이 있으면 따옴표로 감싼다. 예: LANGSMITH_PROJECT="AI Agent "
LANGSMITH_PROJECT=day1-demo
