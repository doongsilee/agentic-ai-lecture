# ──────────────────────────────────────────────────────────────
#  1일차 실습 · 환경 변수 (2일차 저장소와 같은 이름 · 같은 규칙)
#  cp .env.example .env 만 하면 키 없이 mock 으로 전부 돕니다
#  교육 당일 강사가 조별 OpenRouter 키를 나눠 주면 아래 "당일 바꿀 줄" 만 고칩니다
# ──────────────────────────────────────────────────────────────

# LLM — OpenAI 호환 주소라면 무엇이든 OK
#   mock   : 네트워크 없이 흐름만 확인 (정해진 답)
#   cloud  : OpenRouter — 당일 사용
#   ollama : 내 노트북의 Ollama
#   relay  : 자체 중계 서버(vLLM 등 OpenAI 호환 주소)
LLM_MODE=mock
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=team-key-here
LLM_MODEL=qwen/qwen3-32b
LLM_TIMEOUT_SEC=60
# 한 번 답의 최대 길이. OpenRouter 는 동시에 진행 중인 요청의 "예상 비용" 합에 한도를 두고, 이 값만큼 미리 잡는다
#   교실 전체가 한꺼번에 부르면 크게 잡을수록 402 가 나기 쉽다 → 실습 답은 짧으니 2048 이면 충분
LLM_MAX_TOKENS=2048

# [당일 바꿀 줄]
# LLM_MODE=cloud
# LLM_API_KEY=sk-or-v1-...

# Ollama 로 바꿀 때
# LLM_MODE=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:8b

# 루프에서 모델을 최대 몇 번까지 부를지 (실습 5 · 6)
MAX_STEPS=8
